        <!-- 3a. Daily Sunnah Challenge Screen -->
        <section id="dailyChallengeScreen" class="hidden gold-card rounded-3xl p-5 sm:p-8">
            <div class="text-center mb-5">
                <span class="text-4xl">🌙✨</span>
                <h2 class="text-2xl font-bold text-amber-300 serif-bn mt-2">দৈনিক সুন্নাহ ও আমল চ্যালেঞ্জ</h2>
                <p class="text-xs sm:text-sm text-emerald-200 mt-1">আজকের ৩টি সুন্নাহ ভিত্তিক লক্ষ্য পূরণ করে ৫০ কয়েন বোনাস সংগ্রহ করুন!</p>
            </div>

            <div id="dailyTasksList" class="space-y-3 mb-6"></div>

            <div class="text-center">
                <button id="claimDailyBtn" onclick="claimDailyReward()" class="btn-gold px-6 py-3 rounded-xl text-sm sm:text-base w-full sm:w-auto">
                    🎁 বোনাস ৫০ কয়েন সংগ্রহ করুন
                </button>
