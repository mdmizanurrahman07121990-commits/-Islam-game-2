        <!-- 3b. Hadith & Adab Pair-Matching Challenge Screen -->
        <section id="matchChallengeScreen" class="hidden gold-card rounded-3xl p-5 sm:p-8">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-amber-400/20">
                <div>
                    <span class="text-xs text-amber-300">বিশেষ চ্যালেঞ্জ</span>
                    <h3 class="text-lg sm:text-xl font-bold text-white serif-bn">🧩 হাদিস ও আদব জোড়া মেলানো</h3>
                </div>
                <div class="text-sm font-bold text-amber-300">
                    মিল হয়েছে: <span id="matchCountDisplay">০</span> / ৪
